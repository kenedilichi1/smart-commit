{
  "name": "smart-commit",
  "version": "1.0.0",
  "description": "AI-powered git commit message generator using a local LLM. No API keys required.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "smart-commit": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": ["git", "commit", "ai", "llm", "cli", "conventional-commits"],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/smart-commit.git"
  },
  "homepage": "https://github.com/your-username/smart-commit#readme",
  "bugs": {
    "url": "https://github.com/your-username/smart-commit/issues"
  },
  "dependencies": {
    "node-llama-cpp": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
