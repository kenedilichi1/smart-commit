# smart-commit — Environment Variables
# Copy this file to .env if you want to set persistent defaults locally.
# All variables are optional; the defaults shown here are used when unset.

# ─────────────────────────────────────────────
# AI Inference Timeout
# ─────────────────────────────────────────────
# How long (in milliseconds) to wait for the local LLM to produce a result
# before killing the worker process and surfacing a timeout error.
#
# Increase this on slow machines (e.g. 300000 = 5 min).
# Set to 0 to disable the timeout entirely (not recommended).
#
# Default: 30000 (30 seconds)
SMART_COMMIT_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# Model Storage Directory (XDG override)
# ─────────────────────────────────────────────
# Overrides the base directory used for storing the downloaded model file.
# The model will be placed at: $XDG_DATA_HOME/smart-commit/models/
#
# Useful if your home partition is small or you want the model on a faster drive.
# When unset, the XDG default (~/.local/share/smart-commit/models/) is used.
#
# Default: unset  →  ~/.local/share/smart-commit/models/
# XDG_DATA_HOME=/mnt/fast-ssd/.local/share
